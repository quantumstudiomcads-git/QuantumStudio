# PRIVATE SIGNING HOST ONLY. Reference checklist; not automatically loaded.
# Never place QS_LICENCE_SIGNING_KEY in Pages/Functions, desktop builds or tracked files.
# Use staging with an independently provisioned staging key first.
BETA_ENVIRONMENT=production
QS_LICENCE_SIGNING_ISSUER_ID=
QS_LICENCE_SIGNING_PUBLIC_KEY=
# Secret JSON contract: see docs/beta/PRODUCTION_SIGNING_AUTHORITY.md.
# No key generation or persistence is performed by the signer.
QS_LICENCE_SIGNING_KEY=
# TEST switches and QS_TEST_LICENCE_TRUST_FILE must be absent or disabled.

# Private signing service only. Secret JSON caller allowlist; no real values here:
QS_SIGNING_SERVICE_AUTH=
# Explicit absolute private durable SQLite journal path (independent from operator.sqlite3):
QS_SIGNING_SERVICE_STATE_PATH=
# Existing authoritative website export, fetched independently by the private service:
QS_OPERATOR_WEBSITE_URL=
QS_OPERATOR_SYNC_TOKEN=
