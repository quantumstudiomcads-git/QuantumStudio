# Copy to .dev.vars for local Wrangler Pages development. Never commit .dev.vars.
BETA_ENVIRONMENT=local
BETA_ALLOWED_ORIGIN=http://localhost:8788
BETA_PRIVACY_VERSION=draft-0.1
BETA_TERMS_VERSION=draft-0.1
BETA_IDENTITY_PEPPER=replace-with-a-long-local-development-only-value
TURNSTILE_SECRET_KEY=local-test-only-placeholder
BETA_TURNSTILE_TEST_MODE=true
AUTH_EMAIL_TEST_MODE=true
AUTH_OTP_PEPPER=replace-with-a-local-development-only-otp-pepper
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8788/api/auth/google/callback

# Public build-time values. Set these in the Pages build environment, not here.
# TURNSTILE_SITE_KEY=replace-with-public-site-key
# BETA_TURNSTILE_TEST_MODE=false
# AUTH_EMAIL_TEST_MODE=false
