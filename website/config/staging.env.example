# Reference checklist only; NOT automatically loaded. Never paste secrets into tracked files.
# Enter these in the matching Pages dashboard Variables and Secrets environment.
# Dashboard configuration supplies build variables and runtime bindings; Wrangler is local-only.
# A dedicated staging Pages project may use the Pages Production deployment slot.
# Match its runtime compatibility date to the reviewed local Wrangler date.
# Use independent staging resources and secrets; do not copy local .dev.vars.
BETA_ENVIRONMENT=staging
BETA_ALLOWED_ORIGIN=
# Public build-only widget key, registered for this environment's hostname:
TURNSTILE_SITE_KEY=
BETA_TURNSTILE_TEST_MODE=false
AUTH_EMAIL_TEST_MODE=false
CLOUDFLARE_LOCAL=false
# Runtime non-secret consent document versions:
BETA_PRIVACY_VERSION=
BETA_TERMS_VERSION=
# Bind BETA_DB to this environment's D1 database; use existing migrations.
# Runtime encrypted secret bindings (no values belong in this tracked file):
BETA_IDENTITY_PEPPER=
AUTH_OTP_PEPPER=
TURNSTILE_SECRET_KEY=
OPERATOR_SYNC_TOKEN=
OPERATOR_STATUS_SYNC_TOKEN=
OPERATOR_LICENCE_SYNC_TOKEN=
OPERATOR_LICENCE_PUBLISH_TOKEN=
OPERATOR_ACTIVATION_REVOKE_TOKEN=
# Google sign-in additionally requires these runtime bindings:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# No private signing key belongs on Pages, in the public build, or in this file.
