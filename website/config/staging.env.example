# Reference checklist only; NOT automatically loaded. Never paste secrets into tracked files.
# Enter these in the matching Pages dashboard Variables and Secrets environment.
# Dashboard configuration supplies build variables and runtime bindings; Wrangler is local-only.
# A dedicated staging Pages project may use the Pages Production deployment slot.
# Match its runtime compatibility date to the reviewed local Wrangler date.
# Use independent staging resources and secrets; do not copy local .dev.vars.
BETA_ENVIRONMENT=staging
BETA_ALLOWED_ORIGIN=
# Public build-only widget key, registered for this environment's hostname:
TURNSTILE_SITE_KEY=
BETA_TURNSTILE_TEST_MODE=false
AUTH_EMAIL_TEST_MODE=false
# Runtime email configuration only; leave the API key unconfigured until sender DNS is verified.
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=
# Encrypted Pages secret, never a public build variable or tracked real value:
RESEND_API_KEY=
CLOUDFLARE_LOCAL=false
# Runtime non-secret consent document versions:
BETA_PRIVACY_VERSION=
BETA_TERMS_VERSION=
# Bind BETA_DB to this environment's D1 database; use existing migrations.
# Runtime encrypted secret bindings (no values belong in this tracked file):
BETA_IDENTITY_PEPPER=
AUTH_OTP_PEPPER=
TURNSTILE_SECRET_KEY=
OPERATOR_SYNC_TOKEN=
OPERATOR_STATUS_SYNC_TOKEN=
OPERATOR_LICENCE_SYNC_TOKEN=
OPERATOR_LICENCE_PUBLISH_TOKEN=
OPERATOR_ACTIVATION_REVOKE_TOKEN=
# Google sign-in additionally requires these runtime bindings:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# No private signing key belongs on Pages, in the public build, or in this file.

# Private signing integration (Pages runtime only; never build/frontend settings).
# Bind SIGNING_SERVICE to the matching private signing Worker in Cloudflare Pages.
# Encrypted JSON secret: {"schema_version":1,"environment":"ENVIRONMENT","caller":"APPROVED_CALLER","secret":"CANONICAL_BASE64URL_32_BYTE_CALLER_SECRET"}
# Replace ENVIRONMENT with the matching profile; leave real credentials out of this file.
QS_SIGNING_SERVICE_CALLER=
# Public environment-bound trust JSON, same schema as desktop QS_LICENCE_TRUST.
QS_LICENCE_TRUST=

# Web admin is disabled by default; authorize verified immutable user IDs out of band.
# Runtime only, never embed this allowlist in a public build.
QS_ADMIN_ENABLED=false
# JSON array of approved canonical user UUIDs, 1-20 entries, no email addresses:
QS_ADMIN_USER_IDS=
